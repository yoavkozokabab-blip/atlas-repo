# =========================================================
# J.A.R.V.I.S — STABLE DESKTOP + TRADING OPS FOUNDATION
# =========================================================

# -----------------------------
# Runtime mode
# -----------------------------
VOICE_RUNTIME_MODE=stable
VOICE_LATENCY_MODE=

# -----------------------------
# Logging / Core
# -----------------------------
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.65
CONFIRMATION_TIMEOUT_SECONDS=120

# -----------------------------
# Voice / STT
# -----------------------------
VOICE_ENABLED=true
VOICE_PROFILE=balanced

STT_ENGINE=faster_whisper
STT_MODEL=small

STT_LANGUAGE=en
STT_ENABLE_NORMALIZATION=true

STT_SAMPLE_RATE=16000

STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

STT_BEAM_SIZE=2
STT_VAD_FILTER=true

FAST_VOICE_MODE=true

STT_MAX_RECORD_SECONDS=5
STT_RECORDING_MAX_SECONDS=20

STT_SILENCE_STOP_ENABLED=true
STT_SILENCE_SECONDS=1.6
STT_SILENCE_THRESHOLD=0.012

STT_LOW_CONFIDENCE_BLOCK_WAKE=false
STT_LOW_CONFIDENCE_TTS_PROMPT=true

VOICE_GRAMMAR_MIN_SCORE=85

# -----------------------------
# Disable unstable streaming
# -----------------------------
STT_STREAMING_BUFFER_ENABLED=false
CONVERSATION_SEMANTIC_STREAM_ENABLED=false

STT_MULTIPASS_ENABLED=false
STT_STACK_ENABLED=false
STT_RETRY_ON_UNKNOWN=false

# -----------------------------
# Wake Word
# -----------------------------
WAKE_WORD_ENABLED=true
WAKE_WORD_ENGINE=openwakeword
WAKE_WORD_MODEL=jarvis

WAKE_WORD_THRESHOLD=0.55

WAKE_MAX_LISTEN_SECONDS=5
WAKE_COOLDOWN_SECONDS=4

WAKE_EARLY_STOP_ENABLED=true

WAKE_POST_SPEECH_BUFFER_MS=700
WAKE_MIN_SPEECH_SECONDS=0.45
WAKE_MIN_TOTAL_SECONDS=0.6
WAKE_SILENCE_SECONDS=1.6

WAKE_WORD_SAMPLE_RATE=16000

WAKE_WORD_NOTIFY=true
WAKE_WORD_DEBUG=false

WAKE_WORD_DISPLAY_PHRASES=Jarvis, Hey Jarvis

# -----------------------------
# TTS / AUDIO
# -----------------------------
TOOL_FIRST_MODE=true

TTS_ENABLED=true

TTS_ENGINE=pyttsx3
TTS_FORCE_ENGINE=pyttsx3

TTS_SAFE_MODE=true

TTS_ASYNC=false
TTS_STREAMING_ENABLED=false
TTS_BARGE_IN_ENABLED=false

TTS_LANGUAGE=en
TTS_VOICE=en-US-GuyNeural

TTS_RATE=+15%
TTS_VOLUME=1.0
TTS_MAX_CHARS=220

TTS_STARTUP_SELF_TEST=true

TTS_FORCE_DEFAULT_WINDOWS_DEVICE=true
TTS_WARN_INACTIVE_DEVICE=true

TTS_FORCE_WINDOWS_DEFAULT_OUTPUT=true

TTS_SPEAK_MAX_SECONDS=8
TTS_TIMEOUT_SECONDS=8

# -----------------------------
# Overlay / HUD
# -----------------------------
OVERLAY_ENABLED=true

OVERLAY_ALWAYS_ON_TOP=true
OVERLAY_OPACITY=0.92

OVERLAY_STYLE=premium_ironman_full
OVERLAY_THEME=jarvis_blue

OVERLAY_WIDTH_RATIO=0.92
OVERLAY_HEIGHT_RATIO=0.88

OVERLAY_POSITION=center

OVERLAY_SHOW_TRANSCRIPT=true
OVERLAY_SHOW_RESULT=true
OVERLAY_SHOW_SYSTEM_PANELS=true
OVERLAY_SHOW_COMMAND_HISTORY=true
OVERLAY_SHOW_WAVEFORM=true
OVERLAY_SHOW_HUD_LABELS=true
OVERLAY_SHOW_AUDIO_PULSE=true
OVERLAY_SHOW_ROTATING_RINGS=true

OVERLAY_FADE_MS=300
OVERLAY_MAX_TEXT_CHARS=500

OVERLAY_AUTO_HIDE_SECONDS=12
OVERLAY_STAY_OPEN_ON_ERROR=true
OVERLAY_STAY_OPEN_ON_SUGGESTIONS=true
OVERLAY_READY_VISIBLE_SECONDS=8

# -----------------------------
# Background runtime
# -----------------------------
BACKGROUND_MODE=true

START_MINIMIZED=true

OVERLAY_START_HIDDEN=true
OVERLAY_SHOW_ON_WAKE=true

# -----------------------------
# User
# -----------------------------
JARVIS_USER_NAME=Yoav

WAKE_GREETING_ENABLED=false

# -----------------------------
# Memory / Project
# -----------------------------
MEMORY_ENABLED=true

PROJECT_INDEXING_ENABLED=true
PROJECT_INDEX_MAX_FILE_KB=512

# -----------------------------
# Vision / OCR
# -----------------------------
VISION_ENABLED=true

VISION_CAPTURE_DIR=data/screenshots
VISION_MAX_SCREENSHOT_AGE_SECONDS=300

VISION_OCR_ENABLED=true
VISION_OCR_LANGUAGE=eng+heb

VISION_SAVE_SCREENSHOTS=false
VISION_REDACT_SENSITIVE_TEXT=true

# -----------------------------
# Screen understanding
# -----------------------------
SCREEN_UNDERSTANDING_ENABLED=true

SCREEN_CAPTURE_MODE=active_window
SCREEN_CAPTURE_SAVE_DEBUG=false

SCREEN_OCR_ENABLED=true

SCREEN_REDACTION_ENABLED=true
SCREEN_BLOCK_SECRET_WINDOWS=true

# -----------------------------
# Diagnostics
# -----------------------------
WATCHDOG_INTERVAL_SECONDS=120
WATCHDOG_NOTIFY_CRITICAL=true

# -----------------------------
# Safe desktop control
# -----------------------------
COMPUTER_CONTROL_ENABLED=true
GUIDED_UI_ENABLED=true

CLIPBOARD_MAX_CHARS=1000

# -----------------------------
# Browser DOM
# -----------------------------
BROWSER_DOM_ENABLED=false
BROWSER_DOM_ALLOWLIST=dashboard,chatgpt,tradingview,yohananof

# -----------------------------
# Task Agent / Patch System
# -----------------------------
PATCH_APPLY_ENABLED=true

TASK_QUEUE_MAX_RUNTIME_SECONDS=3600

TASK_AGENT_ALLOW_PATCH_APPLY=false
TASK_AGENT_RUN_TESTS_AFTER_PATCH=true

# -----------------------------
# Runtime healing
# -----------------------------
HEALING_ENGINE_ENABLED=true

HEALING_MAX_RECOVERIES_PER_HOUR=6
HEALING_RECOVERY_COOLDOWN_SECONDS=120

RUNTIME_HEALTH_ENABLED=true
RUNTIME_HEARTBEAT_ENABLED=true

# -----------------------------
# Dashboard health stabilization
# -----------------------------
DASHBOARD_HEALTH_GRACE_SECONDS=20
DASHBOARD_HEALTH_RETRY_COUNT=4
DASHBOARD_HEALTH_RETRY_DELAY_SECONDS=2

# -----------------------------
# Queue / reliability
# -----------------------------
CONSOLE_QUEUE_ENABLED=true
CONSOLE_QUEUE_MAX_SIZE=100

COMMAND_TIMEOUT_SECONDS=120

# -----------------------------
# Overlay performance
# -----------------------------
OVERLAY_UPDATE_QUEUE_SIZE=32
OVERLAY_STARTUP_WAIT_SECONDS=0.5
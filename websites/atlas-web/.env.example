# Atlas website - environment configuration (copy to .env.local for local dev).
# .env.local is gitignored. Never commit real values.

# Public support/contact email shown on public pages.
NEXT_PUBLIC_SUPPORT_EMAIL=yoavkozokabab@gmail.com
NEXT_PUBLIC_HELLO_EMAIL=yoavkozokabab@gmail.com
NEXT_PUBLIC_SECURITY_EMAIL=yoavkozokabab@gmail.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/useatlas
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public app version shown in UI / health probe.
NEXT_PUBLIC_ATLAS_VERSION=1.0.0

# --- Sessions (REQUIRED in production) ---
# 32+ random bytes. Without it, sessions reset on every restart/redeploy.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Comma-separated admin emails.
ADMIN_EMAILS=

# --- Persistence backend (REQUIRED in production) ---
# When both are set, the app uses Supabase. When unset, it falls back to a local
# JSON file for dev only. See supabase/migrations/0001_init.sql and docs/SUPABASE_SETUP.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Installer download (REQUIRED in production) ---
# TODO: Set this to the current GitHub Release installer asset.
NEXT_PUBLIC_DOWNLOAD_URL=
# Server fallback used by /download/atlas if NEXT_PUBLIC_DOWNLOAD_URL is unset.
ATLAS_INSTALLER_URL=
# Local dev only: absolute path to a built installer to stream directly.
# ATLAS_INSTALLER_PATH=

# --- Payments (Paddle; optional until Pro checkout is ready) ---
# Paddle is Merchant of Record for paid subscriptions. Do not enable Pro checkout
# until these are set to real dashboard values.
PAYMENTS_MODE=stub
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_PRO_PRICE_ID=
PADDLE_WEBHOOK_SECRET=

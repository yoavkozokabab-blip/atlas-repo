# Atlas website — environment configuration (copy to .env.local for local dev).
# .env.local is gitignored. Never commit real values.

# Public support/contact email shown on the Contact page and footer.
# (Public content — safe to expose to the client. Not a secret.)
NEXT_PUBLIC_SUPPORT_EMAIL=you@example.com

# Public app version shown in UI / health probe.
NEXT_PUBLIC_ATLAS_VERSION=0.1.0-beta

# --- Sessions (REQUIRED in production) ---
# 32+ random bytes. Without it, sessions reset on every restart/redeploy.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Comma-separated admin emails (get the admin dashboard + waitlist export).
ADMIN_EMAILS=

# --- Persistence backend (REQUIRED in production) ---
# When both are set, the app uses Supabase (survives redeploys). When unset, it
# falls back to a local JSON file — fine for dev, EPHEMERAL on Vercel. See
# supabase/migrations/0001_init.sql and docs/SUPABASE_SETUP.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon key is not used server-side but kept for reference / future client use.
SUPABASE_ANON_KEY=

# --- Installer download (REQUIRED in production) ---
# Production: a stable URL to the hosted installer (GitHub Release asset / CDN).
# The /download/atlas route 302-redirects here. See docs/RELEASE_PROCESS.md.
ATLAS_INSTALLER_URL=
# Local dev only: absolute path to a built installer to stream directly.
# ATLAS_INSTALLER_PATH=

# --- Payments (optional; stub by default — no real charges) ---
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
# PAYMENTS_MODE=test

# Atlas desktop — optional environment overrides.
# Everything works with zero configuration; set these only when you need to.
# The website has its own env file: websites/atlas-web/.env.example

# Data directory override (default: %USERPROFILE%\.atlas_desktop, with
# LOCALAPPDATA and TEMP fallbacks when the home dir is not writable).
# ATLAS_DESKTOP_DATA=C:\path\to\writable\dir

# Website/auth base URL the desktop authenticates against (packaged builds).
# ATLAS_WEB_URL=https://useatlas.dev

# Use the local dev accounts service instead of the website auth (dev only).
# ATLAS_LOCAL_ACCOUNTS=1

# Support email shown in the desktop UI.
# ATLAS_SUPPORT_EMAIL=atlas.repo.support@gmail.com

# Remote feedback destination; unset = feedback is stored locally only.
# ATLAS_FEEDBACK_URL=

# Update check endpoint; unset = no update checks.
# ATLAS_UPDATE_CHECK_URL=

# Show the billing/usage UI (default off while paid plans are not live).
# ATLAS_BILLING_UI_ENABLED=0

# Production billing sync (server-to-server only; never ship secrets in
# public desktop bundles).
# ATLAS_BILLING_LICENSE_URL=https://your-production-domain.com/api/license
# ATLAS_BILLING_SYNC_SECRET=
# ATLAS_BILLING_SYNC_REQUIRED=false

# Dev/diagnostics toggles.
# ATLAS_DEV=1
# ATLAS_ADMIN=1
# ATLAS_ANALYTICS_DIAG=1

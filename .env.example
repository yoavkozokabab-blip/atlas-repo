# LLM provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (optional, not used in Phase 1)
# OPENAI_API_KEY=

# Telegram (optional, not used in Phase 1)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Paths (override defaults if needed)
# TRADING_PROJECT_ROOT=C:\FINAL_ALGO_TRADER
# CURSOR_EXE=C:\Users\You\AppData\Local\Programs\cursor\Cursor.exe
# CHROME_EXE=C:\Program Files\Google\Chrome\Application\chrome.exe

# Logging
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.65
CONFIRMATION_TIMEOUT_SECONDS=120

# Voice runtime preset (stable = known-good CPU baseline; overrides conflicting keys)
# VOICE_RUNTIME_MODE=stable
# Sub-500ms voice response mode (keeps router/security/registry path)
# VOICE_LATENCY_MODE=instant

# Voice / STT
VOICE_ENABLED=false
# Recommended live profile (fast + reliable STT, sync pyttsx3 TTS):
# VOICE_PROFILE=balanced
# STT_MODEL=small
# STT_BEAM_SIZE=3
# TTS_ENGINE=pyttsx3
# TTS_ASYNC=false
# TTS_STARTUP_SELF_TEST=true
STT_ENGINE=faster_whisper
STT_MODEL=medium
STT_LANGUAGE=en
STT_ENABLE_NORMALIZATION=true
STT_SAMPLE_RATE=16000
STT_RECORDING_MAX_SECONDS=20
# Prefer CUDA when available; falls back to CPU int8 automatically if no GPU
STT_DEVICE=cuda
STT_ACCELERATION_AUTO=true
STT_FAST_PROFILE=false
STT_PREFER_DIRECTML=false
# AMD/Intel GPU (optional): pip install onnxruntime-directml onnx-asr[cpu,hub]
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=1
STT_VAD_FILTER=true
# VOICE_PROFILE=fast -> beam 1-2 (recommended with streaming defaults below)
# VOICE_PROFILE=balanced -> STT_MODEL=small, beam 3
# VOICE_PROFILE=accurate -> STT_MODEL=medium, beam 3, low-conf block on

# Wake / recording reliability
FAST_VOICE_MODE=false
STT_MAX_RECORD_SECONDS=5
STT_SILENCE_STOP_ENABLED=false
STT_SILENCE_SECONDS=1.2
STT_SILENCE_THRESHOLD=0.012
VOICE_GRAMMAR_MIN_SCORE=85
WAKE_MAX_LISTEN_SECONDS=5
WAKE_EARLY_STOP_ENABLED=true
WAKE_POST_SPEECH_BUFFER_MS=700
WAKE_MIN_SPEECH_SECONDS=0.45
WAKE_MIN_TOTAL_SECONDS=0.6
# Longer pause before wake capture ends (reduces clipped commands)
WAKE_SILENCE_SECONDS=1.6

# Low confidence handling
STT_LOW_CONFIDENCE_BLOCK_WAKE=false
STT_LOW_CONFIDENCE_TTS_PROMPT=true

# ===== Phase 42.6 / 42.7 — Streaming conversation (CPU-safe defaults) =====
STT_STREAMING_BUFFER_ENABLED=true
STT_STREAM_PARTIAL_DECODE_MAX_MS=2500
STT_STREAM_PARTIAL_TIMEOUT_SECONDS=2.5
STT_STREAM_STARTUP_GRACE_SECONDS=10
STT_STREAM_PARTIAL_MAX_FAILURES=3
STT_STREAM_PARTIAL_RETRY_COUNT=2
STT_STREAM_PARTIAL_ACCURATE_RETRY_ENABLED=false
STT_STREAM_FINAL_ACCURATE_RETRY_ENABLED=true
STT_WAKE_FALLBACK_TIMEOUT_SECONDS=12
STT_PARTIAL_INTERVAL_MS=250
STT_STREAM_GPU_FIRST=true
STT_STREAM_MAX_BUFFER_SECONDS=2.5
STT_ROLLING_BUFFER_SECONDS=2.5
STT_STREAM_CHUNK_MS=100
STT_STREAM_OVERLAP_MS=50
STT_STREAM_MIN_PARTIAL_CONTEXT_MS=250
STT_STREAM_ENDPOINT_SILENCE_MS=700
STT_INTENT_PREFETCH_ENABLED=true

# Instant mode recommended values:
# STT_MODEL=base
# STT_BEAM_SIZE=1
# STT_MULTIPASS_ENABLED=false
# STT_STACK_ENABLED=false
# STT_RETRY_ON_UNKNOWN=false
# STT_PARTIAL_INTERVAL_MS=200
# STT_ROLLING_BUFFER_SECONDS=2.0
# STT_STREAM_MAX_BUFFER_SECONDS=2.0
# STT_STREAM_MIN_PARTIAL_CONTEXT_MS=200
# STT_STREAM_ENDPOINT_SILENCE_MS=450
# CONVERSATION_SEMANTIC_STREAM_ENABLED=true

CONVERSATION_SEMANTIC_STREAM_ENABLED=true
CONV_SEMANTIC_UPDATE_MIN_MS=80
CONV_SEMANTIC_LATENCY_BUDGET_MS=200
CONV_ACTION_PLAN_ENABLED=true
CONV_MULTI_INTENT_ENABLED=true
CONV_CORRECTION_ENABLED=true
CONV_CONTEXT_CARRY_ENABLED=true
CONV_INTERRUPTION_ENABLED=true
CONV_REFORMULATION_ENABLED=true
CONV_CONFIDENCE_STABILITY_THRESHOLD=0.72

# Phase 42.5 — semantic command understanding (local; router still executes)
SEMANTIC_UNDERSTANDING_ENABLED=true
SEMANTIC_LLM_ENABLED=false
SEMANTIC_LLM_PROVIDER=ollama
SEMANTIC_LLM_MODEL=llama3.1:8b
SEMANTIC_LLM_TIMEOUT_SECONDS=4
SEMANTIC_MIN_CONFIDENCE=0.72
VOCABULARY_CORRECTION_ENABLED=true
VOCABULARY_MAX_EDIT_DISTANCE=2

# Phase 42 v2 — elite speech recognition (multipass + grammar; off by default on CPU)
STT_MULTIPASS_ENABLED=false
STT_RETRY_ON_UNKNOWN=true
STT_ACCURATE_RETRY_BEAM_SIZE=5
STT_ACCURATE_RETRY_MAX_MS=2500
VOICE_CALIBRATION_ENABLED=true
VOICE_CALIBRATION_MAX_SAMPLES=20
WAKE_FALSE_TRIGGER_COOLDOWN_SECONDS=2.5

# Phase 42 — multi-backend STT stack (fusion, repair, retry)
STT_STACK_ENABLED=false
STT_ENGINE_CHAIN=faster_whisper,onnx_whisper,whisper_cpp,parakeet,deepgram_local
STT_FUSION_ENABLED=true
STT_PARTIAL_STREAMING_ENABLED=true
STT_INTENT_CORRECTION_ENABLED=true
STT_TRANSCRIPT_REPAIR_ENABLED=true
STT_VOICE_FINGERPRINT_ENABLED=true
STT_NOISE_SUPPRESSION_ENABLED=true
STT_ECHO_CANCELLATION_ENABLED=true
STT_AUTO_LANGUAGE_DETECT=false
STT_RETRY_MAX_ATTEMPTS=2
# WHISPER_CPP_BINARY=
# WHISPER_CPP_MODEL=
# PARAKEET_MODEL_PATH=
# DEEPGRAM_LOCAL_URL=http://127.0.0.1:8080

# TTS
TOOL_FIRST_MODE=true
TTS_ENABLED=false
TTS_ENGINE=pyttsx3
# Optional hard override when Windows audio should always use pyttsx3:
# TTS_FORCE_ENGINE=pyttsx3
TTS_LANGUAGE=en
TTS_VOICE=en-US-GuyNeural
TTS_RATE=+15%
TTS_VOLUME=1.0
TTS_MAX_CHARS=220
TTS_ASYNC=false
TTS_STARTUP_SELF_TEST=true
TTS_FORCE_DEFAULT_WINDOWS_DEVICE=true
TTS_FORCE_WINDOWS_DEFAULT_OUTPUT=true
TTS_WARN_INACTIVE_DEVICE=true
TTS_FAST_SUMMARY_ENABLED=true
# Offline fallback only: TTS_ENGINE=pyttsx3  TTS_RATE=185

# Phase 41 — premium human voice stack
# Recommended cinematic female assistant:
# TTS_ENGINE=edge_tts
# TTS_VOICE=en-US-JennyNeural
TTS_STREAMING_ENABLED=true
TTS_BARGE_IN_ENABLED=true

# Phase 57 — low-latency realtime streaming TTS (pyttsx3 fallback-only)
REALTIME_TTS_ENABLED=true
PYTTSX3_FALLBACK_ONLY=true
TTS_PRIMARY_BACKEND=realtime
TTS_FALLBACK_BACKEND=pyttsx3_direct
REALTIME_TTS_PROVIDER_ORDER=openai_realtime,elevenlabs,piper,pyttsx3_fallback
# VOICE_RUNTIME_MODE=realtime_experimental
# REALTIME_TTS_PREFERRED=openai_realtime
# REALTIME_TTS_EMOTION=neutral
# VOICE_COMMAND_GUARD_ENABLED=true
# VOICE_GUARD_MIN_WORDS=3
# OPENAI_API_KEY=
# OPENAI_TTS_VOICE=alloy
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# PIPER_BIN=piper
# PIPER_MODEL=C:\path\to\voice.onnx

# Phase 41.6 — stable blocking pyttsx3 (bypass streaming/async/routing)
# TTS_SAFE_MODE=true
# TTS_DEBUG_PLAYBACK=true
VOICE_STACK_STARTUP_CALIBRATION=true
# Optional local engines (install separately):
# PIPER_BIN=piper
# PIPER_MODEL=C:\path\to\voice.onnx
# XTTS_MODEL_PATH=
# STYLETTS2_SCRIPT=

# LLM intent classifier
LLM_CLASSIFIER_ENABLED=false
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=8
LLM_MIN_CONFIDENCE=0.75
LLM_FALLBACK_TO_RULES=true

# Vision / screen understanding
VISION_ENABLED=false
VISION_CAPTURE_DIR=data/screenshots
VISION_MAX_SCREENSHOT_AGE_SECONDS=300
VISION_OCR_ENABLED=true
VISION_OCR_LANGUAGE=eng+heb
VISION_SAVE_SCREENSHOTS=false
VISION_REDACT_SENSITIVE_TEXT=true
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
SCREEN_UNDERSTANDING_ENABLED=true
SCREEN_CAPTURE_ALLOW=true
SCREEN_CAPTURE_MODE=active_window
SCREEN_CAPTURE_SAVE_DEBUG=false
SCREEN_CAPTURE_TEMP_DIR=reports/screen_temp
SCREEN_OCR_ENABLED=true
SCREEN_OCR_ENGINE=auto
SCREEN_MAX_TEXT_CHARS=4000
SCREEN_REDACTION_ENABLED=true
SCREEN_BLOCK_SECRET_WINDOWS=true
SCREEN_BLOCKED_WINDOW_KEYWORDS=.env,secret,password,token,api key,private key,credential,wallet,recovery phrase,seed phrase
SCREEN_FIND_MAX_RESULTS=10

# Conversation
CONVERSATION_ENABLED=true
CONVERSATION_MAX_TURNS=20
CONVERSATION_CLASSIFY_CONTEXT_TURNS=8
CONVERSATION_MAX_SUMMARY_CHARS=200
CONVERSATION_MAX_RAW_CHARS=120
CONVERSATION_CONTINUATION_ENABLED=true
CONVERSATION_MAX_SUGGESTIONS=4
CONVERSATION_FAST_ACK_ENABLED=true
# Human conversation — barge-in, memory window, streaming speech chunks
HUMAN_CONVERSATIONAL_RUNTIME_ENABLED=true
HUMAN_BARGE_IN_TARGET_MS=200
CONVERSATION_STREAM_FIRST_CHUNK_CHARS=18
CONVERSATION_STREAM_MIN_CHARS=28
CONVERSATION_TARGET_INTERRUPT_PAUSE_MS=100
ASYNC_PERSISTENCE_ENABLED=false

# Watchdog + runtime stability
WATCHDOG_INTERVAL_SECONDS=120
WATCHDOG_NOTIFY_CRITICAL=true
WATCHDOG_RECOVERY_ENABLED=true
WATCHDOG_MAX_RECOVERIES_PER_HOUR=12
RUNTIME_MONITOR_ENABLED=true
RUNTIME_MONITOR_INTERVAL_SECONDS=30
RUNTIME_EVENT_LOOP_LAG_WARN_SECONDS=5
RUNTIME_DEADLOCK_SECONDS=90
RUNTIME_MEMORY_GROWTH_WARN_MB=200
RUNTIME_MEMORY_GROWTH_WINDOW_SECONDS=300
STT_TIMEOUT_SECONDS=45
TTS_TIMEOUT_SECONDS=8
TTS_SPEAK_MAX_SECONDS=8
OVERLAY_RECOVERY_BACKOFF_SECONDS=5
EVENT_BUS_MAX_QUEUE_SIZE=512
EVENT_BUS_BATCH_SIZE=16
EVENT_BUS_WORKER_COUNT=1
BACKGROUND_WORKER_COUNT=2
BACKGROUND_WORK_QUEUE_SIZE=128
RUNTIME_CACHE_TTL_SECONDS=30
RUNTIME_CACHE_MAX_ENTRIES=256
GPU_WORKLOAD_PREFER_GPU=true
GPU_WORKLOAD_BATCH_SIZE=4
STREAM_PIPELINE_QUEUE_SIZE=64
OBSERVABILITY_ENABLED=true
OBSERVABILITY_MAX_MEMORY_EVENTS=500
OBSERVABILITY_LATENCY_BUCKETS_MS=25,50,100,250,500,1000,2500,5000,10000
OVERLAY_FPS_SAMPLE_SECONDS=5

# Computer control (predefined window/clipboard, disabled by default)
COMPUTER_CONTROL_ENABLED=false
CLIPBOARD_MAX_CHARS=1000

# Wake word / background
WAKE_WORD_ENABLED=true
WAKE_WORD_ENGINE=openwakeword
WAKE_WORD_MODEL=jarvis
# jarvis -> openWakeWord hey_jarvis (trained for "Hey Jarvis"; short "Jarvis" also supported)
WAKE_WORD_DISPLAY_PHRASES=Jarvis, Hey Jarvis
WAKE_WORD_THRESHOLD=0.6
# If "Jarvis" alone rarely wakes, try 0.55 (more sensitive; more false positives)
WAKE_COOLDOWN_SECONDS=4
WAKE_WORD_LISTEN_SECONDS_AFTER_WAKE=4
WAKE_WORD_COOLDOWN_SECONDS=4
WAKE_WORD_SAMPLE_RATE=16000
WAKE_WORD_NOTIFY=true
WAKE_WORD_DEBUG=false
WAKE_GREETING_ENABLED=false
JARVIS_USER_NAME=Yoav
BACKGROUND_MODE=false
START_MINIMIZED=false

# Overlay / HUD
OVERLAY_ENABLED=false
OVERLAY_STYLE=premium_ironman_full
OVERLAY_START_HIDDEN=false
OVERLAY_SHOW_ON_WAKE=true
OVERLAY_AUTO_HIDE_SECONDS=12
OVERLAY_STAY_OPEN_ON_ERROR=true
OVERLAY_STAY_OPEN_ON_SUGGESTIONS=true
OVERLAY_READY_VISIBLE_SECONDS=8
OVERLAY_ALWAYS_ON_TOP=true
OVERLAY_OPACITY=0.88
OVERLAY_SHOW_TRANSCRIPT=true
OVERLAY_SHOW_RESULT=true
OVERLAY_WIDTH_RATIO=0.92
OVERLAY_HEIGHT_RATIO=0.88
OVERLAY_POSITION=center
OVERLAY_SHOW_SYSTEM_PANELS=true
OVERLAY_SHOW_COMMAND_HISTORY=true
OVERLAY_SHOW_WAVEFORM=true
OVERLAY_SHOW_HUD_LABELS=true
OVERLAY_THEME=jarvis_blue
OVERLAY_SHOW_AUDIO_PULSE=true
OVERLAY_SHOW_ROTATING_RINGS=true
OVERLAY_FADE_MS=250
OVERLAY_MAX_TEXT_CHARS=500
OVERLAY_TEST_DISPLAY_SECONDS=5

# Wake greeting (TTS only — after wake word, before listening)
WAKE_GREETING_TEXT=Hey {name}
WAKE_GREETING_ASYNC=true
WAKE_GREETING_MAX_DELAY_SECONDS=0.2

# Overlay performance (non-blocking voice path)
OVERLAY_UPDATE_QUEUE_SIZE=32
OVERLAY_STARTUP_WAIT_SECONDS=0.5

# Memory / knowledge
MEMORY_ENABLED=true
PROJECT_INDEXING_ENABLED=true
PROJECT_INDEX_MAX_FILE_KB=512

# Patch / task safety
PATCH_APPLY_ENABLED=true
TASK_AGENT_ALLOW_PATCH_APPLY=true
TASK_AGENT_RUN_TESTS_AFTER_PATCH=true
TASK_AGENT_PATCH_BACKUP_DIR=reports/task_agent/backups
TASK_QUEUE_MAX_RUNTIME_SECONDS=3600
BROWSER_DOM_ENABLED=false
BROWSER_DOM_ALLOWLIST=dashboard,chatgpt,tradingview,yohananof
GUIDED_UI_ENABLED=false

# Phase 40 — operating assistant (read-only awareness + rules assistant)
WORKSPACE_AWARENESS_ENABLED=true
WORKSPACE_SUGGESTIONS_ENABLED=true
ASSISTANT_MODE_ENABLED=true
SESSION_MEMORY_ENABLED=true
SESSION_SUMMARY_EVERY_N=10
HUD_WORKSPACE_MODE_ENABLED=true
HUD_SESSION_TIMELINE_ENABLED=true
# Phase 40b (later):
# LLM_ASSISTANT_ENABLED=false
